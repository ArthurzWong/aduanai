# AduanAI runs live AI triage when a key is present.
# Set one of these and every triage request uses the live model.
# You can also paste a key at runtime from the in-app "AI settings" panel,
# which stores it in the browser only (no server-side key required).

OPENAI_API_KEY=

## Optional overrides (any OpenAI-compatible endpoint works)
# AI_MODEL=gpt-4o-mini
# OPENAI_BASE_URL=https://api.openai.com/v1

## The in-app panel accepts: API key, model, base URL.
## Without a key AduanAI falls back to the deterministic rule engine and
## still returns live geocoded location + weather context.
